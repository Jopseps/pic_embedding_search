node_modules/
dist/
src-tauri/target/
src-tauri/gen/
# Fetched by scripts/fetch-uv.mjs, per target triple. Never committed.
src-tauri/binaries/
# Collected installers + SHA256SUMS from scripts/build-*.
release/

# Python sidecar
sidecar/.venv/
# CPU-torch test env of scripts/build-*; never the dev .venv.
sidecar/.venv-build/
sidecar/.pytest_cache/
__pycache__/
*.py[cod]

.DS_Store
*.log

# Markdown is untracked by default — scratch notes, plans and design briefs stay
# local. README is the only doc that ships; CLAUDE.md, ARCHITECTURE.md and
# PLAN.md are local-only.
*.md
!README.md

# Local-only scratch: stale makepkg output and .deb copies under packaging/arch.
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/*.deb
packaging/arch/*.pkg.tar.*

# Personal rebuild shortcut (wraps scripts/fastbuild.sh) and tool/editor leftovers
/update
.claude/
graphify-out/
.vscode/
.idea/
.env*
coverage/
*.tsbuildinfo
Thumbs.db

.graphify
graphify_out/
