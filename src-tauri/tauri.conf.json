{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Photo Search",
    "version": "0.1.0",
    "identifier": "dev.picsearch.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Photo Search",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 640,
                "resizable": true,
                "theme": "Dark",
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: http://127.0.0.1:* data:; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "appimage"],
        "icon": ["icons/icon.png"]
    }
}
