{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "PicSearch",
    "version": "1.0.4",
    "identifier": "dev.picsearch.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "PicSearch",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 640,
                "resizable": true,
                "theme": "Dark",
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: http://127.0.0.1:* data:; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "nsis"
        ],
        "category": "Photography",
        "shortDescription": "Local semantic photo and screenshot search",
        "longDescription": "Search your photos and screenshots with natural language, in English and Turkish. Everything runs on your machine: SigLIP 2 embeddings on the GPU, Tesseract OCR, no cloud.",
        "publisher": "Jopseps",
        "homepage": "https://github.com/Jopseps/pic_embedding_search",
        "license": "GPL-3.0-or-later",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png",
            "icons/icon.ico"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "tesseract-ocr",
                    "tesseract-ocr-eng"
                ],
                "recommends": [
                    "tesseract-ocr-tur"
                ]
            },
            "appimage": {
                "bundleMediaFramework": false
            }
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "mainBinaryName": "picsearch"
}
